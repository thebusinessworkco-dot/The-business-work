{
  "name": "the-business-work",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seo": "npm run seo:check",
    "seo:check": "vitest run src/lib/jsonld.test.ts src/lib/https.test.ts && node scripts/images-check.mjs",
    "legal:check": "node scripts/legal-check.mjs",
    "test:a11y": "playwright test tests/a11y.spec.ts tests/assistant.spec.ts tests/capabilities.spec.ts",
    "test:e2e": "playwright test tests/responsive.spec.ts tests/cookie-consent.spec.ts",
    "preflight": "node scripts/preflight.mjs",
    "smoke": "node scripts/smoke.mjs",
    "contrast": "node scripts/contrast.mjs",
    "assistant:eval": "node scripts/assistant-eval.mjs",
    "links:check": "node scripts/links-check.mjs",
    "copy:check": "node scripts/plain-words-check.mjs",
    "env:check": "node scripts/env-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.452.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vitest": "^1.6.1"
  },
  "browserslist": [
    "last 2 Chrome versions",
