# Public site URL (used for metadata, canonical links, sitemaps, and strict same-origin API validation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing safety switch: set to "true" only in production when ready to allow search engines to index
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional search engine verification tokens
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Target endpoint where contact-form leads are delivered (Google Apps Script web app or n8n webhook)
LEAD_WEBHOOK_URL=

# Shared secret key used to authenticate webhook submissions
LEAD_WEBHOOK_SECRET=

# Secret delivery method: "header" (x-webhook-secret header, default for n8n) or "body" (required for Google Apps Script)
LEAD_WEBHOOK_SECRET_MODE=header

# Optional fire-and-forget notification webhook URL (e.g. n8n alert flow for WhatsApp/Email)
NOTIFY_WEBHOOK_URL=

# Optional Upstash Redis REST API URL for distributed rate limiting across serverless instances
UPSTASH_REDIS_REST_URL=

# Optional Upstash Redis REST API Token for distributed rate limiting
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# Website Chat Assistant (Gemini API)
# ==============================================================================
# Server-side Gemini API key from Google AI Studio (NEVER expose to client; no NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=

# Gemini model ID. Default set to "gemini-3.8-flash" (official high-efficiency Flash model).
# NOTE: Check Google AI Studio (https://ai.google.dev/pricing) to confirm available models before deployment.
GEMINI_MODEL=gemini-3.8-flash

# Backend chat switch: set to "true" to allow /api/chat to process requests
CHAT_ENABLED=false

# Client-side chat switch: set to "true" to display the chat launcher widget on the site
NEXT_PUBLIC_CHAT_ENABLED=false

# Global daily chat request cap (protects against runaway usage / bills across all visitors)
CHAT_DAILY_LIMIT=500
